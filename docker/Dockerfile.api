FROM python:3.12-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git curl \
    && rm -rf /var/lib/apt/lists/*

# v3 inference dependencies only (no FinBERT pre-download, no chronos/autogluon)
COPY docker/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Non-root runtime user
RUN useradd -m appuser

# Copy source
COPY src/ ./src/
COPY config/ ./config/
COPY main.py .

RUN chown -R appuser:appuser /app
USER appuser

ENV PYTHONPATH=/app
ENV MLFLOW_TRACKING_URI=http://mlflow:5000
ENV OLLAMA_BASE_URL=http://ollama:11434

EXPOSE 8000

# Healthcheck hits /health WITH the API key (B-8)
HEALTHCHECK --interval=30s --timeout=10s --retries=5 \
    CMD python -c "import os,urllib.request; \
req=urllib.request.Request('http://localhost:8000/health', headers={'X-API-Key': os.environ['V3_API_KEY']}); \
urllib.request.urlopen(req)"

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
